digraph resolution {
    graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.55", splines=polyline];
    node [shape=box, style=filled, fillcolor="#ffffff", color="#475569", fontname="sans-serif", fontsize=11, margin="0.16,0.10"];
    edge [color="#475569", fontname="sans-serif", fontsize=10, arrowsize=0.7];

    start [shape=oval, label="user_state_dir()", fillcolor="#dbeafe"];
    select [shape=diamond, label="Debug assertions +\ndevelopment feature?\n(compile time)", fillcolor="#dbeafe"];
    platform [shape=diamond, label="Linux target?\n(compile time)", fillcolor="#dbeafe"];

    cwd [label="Read current\nworking directory"];
    cwd_ok [shape=diamond, label="Lookup succeeded?"];
    local [label="Append .local/state"];

    read_xdg [label="Read XDG_STATE_HOME"];
    xdg [shape=diamond, label="Absolute path?"];
    use_xdg [label="Use XDG_STATE_HOME"];
    home [label="Look up home directory"];
    valid_home [shape=diamond, label="Absolute home\npath available?"];
    fallback [label="Append .local/state\nto home path"];

    error [shape=oval, label="Return error", fillcolor="#fee2e2"];
    result [shape=oval, label="Return PathBuf", fillcolor="#dcfce7"];

    start -> select;
    select -> cwd [label="Yes", style=dashed];
    select -> platform [label="No", style=dashed];
    platform -> read_xdg [label="Yes", style=dashed];
    platform -> error [label="No: unsupported", style=dashed];

    cwd -> cwd_ok;
    cwd_ok -> local [label="Yes"];
    cwd_ok -> error [label="No"];
    local -> result;

    read_xdg -> xdg;
    xdg -> use_xdg [label="Yes"];
    xdg -> home [label="No"];
    use_xdg -> result;
    home -> valid_home;
    valid_home -> fallback [label="Yes"];
    valid_home -> error [label="No"];
    fallback -> result;

    { rank=same; result; error; }
}
