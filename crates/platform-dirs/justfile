# List available tasks.
default:
    @just --list

# Verify this package using the workspace check sequence.
check:
    just --justfile ../../justfile check-package platform-dirs

# Verify native path resolution with the development feature disabled.
check-native:
    just --justfile ../../justfile check-platform-native

# Regenerate and optimize the documentation SVGs.
diagram: diagram-generate diagram-optimize

# Generate the documentation SVGs (requires Graphviz and root pnpm dependencies).
diagram-generate:
    dot -Tsvg docs/architecture.dot -o docs/architecture.svg
    pnpm exec mmdc -i docs/resolution.mmd -o docs/resolution.svg -b transparent

# Optimize the existing documentation SVGs (requires root pnpm dependencies).
diagram-optimize:
    pnpm exec svgo --folder docs
