---
import Layout from "../layouts/Layout.astro";
import Callout from "../components/Callout.astro";
---

<Layout title="Download — Chessvault">
  <h1>Download</h1>
  <Callout kind="warning" id="release-notice-title" title="No stable releases yet">
    <p>Chessvault is still in development. A stable release is not yet available to download.</p>
  </Callout>

  <Callout kind="info" id="platform-notice-title" title="Platform availability">
    <p id="platform-notice-message">
      Development previews are currently available for Linux only. Windows and macOS support is planned. Mobile releases
      are not currently being considered.
    </p>
  </Callout>

  <section class="development-previews" aria-labelledby="development-previews-title">
    <h2 id="development-previews-title">Try a Linux development preview</h2>
    <p>Linux users can get an early look at Chessvault and help test upcoming changes.</p>
    <p>
      <strong>Development previews may contain bugs or incomplete features.</strong>
    </p>
    <p>
      <a href="https://github.com/chessvaultdotapp/chessvault/releases">Browse Linux development previews &rarr;</a>
    </p>
  </section>
</Layout>

<script>
  const browser = navigator as Navigator & {
    userAgentData?: { platform?: string; mobile?: boolean };
  };
  const platform = browser.userAgentData?.platform ?? "";
  const agent = navigator.userAgent;
  const isMobile =
    browser.userAgentData?.mobile === true ||
    /Android|iPhone|iPad|iPod|Mobile/i.test(`${platform} ${agent}`) ||
    (/Mac/i.test(platform || navigator.platform) && navigator.maxTouchPoints > 1);

  const title = document.querySelector("#platform-notice-title");
  const message = document.querySelector("#platform-notice-message");

  const previews = document.querySelector<HTMLElement>(".development-previews");
  const isLinux = !isMobile && /Linux/i.test(platform || agent);

  if (previews) previews.hidden = !isLinux;

  if (title && message) {
    if (isMobile) {
      title.textContent = "Mobile platforms are not supported";
      message.textContent =
        "Releases for mobile platforms are not currently being considered. Development previews are available for Linux desktop only.";
    } else if (/Windows|Win32|Win64/i.test(platform || agent)) {
      title.textContent = "Windows support is planned";
      message.textContent =
        "Windows is not yet supported, but adding support is planned. Development previews are currently available for Linux only.";
    } else if (/macOS|Mac/i.test(platform || agent)) {
      title.textContent = "macOS support is planned";
      message.textContent =
        "macOS is not yet supported, but adding support is planned. Development previews are currently available for Linux only.";
    } else if (/Linux/i.test(platform || agent)) {
      title.textContent = "Development previews for Linux";
      message.textContent =
        "Linux development previews are available. Browse the releases below to choose a package for your system.";
    }
  }
</script>

<style>
  .development-previews {
    margin-block: 2rem;
  }

  .development-previews p + p {
    margin-top: 1rem;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  p {
    margin: 0;
  }
</style>
