---
import sun from "@phosphor-icons/core/assets/regular/sun.svg?raw";
import moon from "@phosphor-icons/core/assets/regular/moon.svg?raw";
import devices from "@phosphor-icons/core/assets/regular/devices.svg?raw";
import github from "@phosphor-icons/core/assets/regular/github-logo.svg?raw";
import Separator from "./Separator.astro";
---

<header>
  <nav aria-label="Main navigation">
    <a class="brand" href={import.meta.env.BASE_URL}>
      Chessvault
    </a>
    <div class="header-actions">
      <a class="nav-button" href={`${import.meta.env.BASE_URL}docs/`}>
        Documentation
      </a>
      <a class="nav-button" href={`${import.meta.env.BASE_URL}download/`}>
        Download
      </a>
      <Separator orientation="vertical" />
      <button id="theme-preference" type="button" aria-label="Theme: system. Switch to light theme">
        <span class="theme-icon light" aria-hidden="true" set:html={sun} />
        <span class="theme-icon dark" aria-hidden="true" set:html={moon} />
        <span class="theme-icon system" aria-hidden="true" set:html={devices} />
      </button>
      <Separator orientation="vertical" />
      <a class="github-link" href="https://github.com/chessvaultdotapp" aria-label="GitHub" title="GitHub">
        <span aria-hidden="true" set:html={github} />
      </a>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("#theme-preference");
  const themes = ["light", "dark", "system"];

  if (button) {
    const updateLabel = () => {
      const current = document.documentElement.dataset.themePreference ?? "system";
      const next = themes[(themes.indexOf(current) + 1) % themes.length];
      const label = `Theme: ${current}. Switch to ${next} theme`;
      button.setAttribute("aria-label", label);
      button.title = label;
    };

    updateLabel();
    button.addEventListener("click", () => {
      const current = document.documentElement.dataset.themePreference ?? "system";
      const next = themes[(themes.indexOf(current) + 1) % themes.length];
      document.dispatchEvent(new CustomEvent("theme-change", { detail: next }));
      updateLabel();
    });
  }
</script>

<style>
  header {
    flex-shrink: 0;
    width: 100%;
    max-width: 70rem;
    margin-inline: auto;
    padding-block: 0.5rem 1.5rem;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .brand {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 800;
    text-decoration: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .nav-button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .nav-button:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 40rem) {
    .header-actions {
      width: 100%;
      justify-content: flex-start;
    }

    .header-actions :global(.separator) {
      display: none;
    }
  }

  .github-link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
  }

  .github-link span {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  .github-link :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font: inherit;
    color: var(--color-text);
    background: var(--color-surface-elevated);
    cursor: pointer;
  }

  .theme-icon {
    display: none;
    width: 1.5rem;
    height: 1.5rem;
  }

  .theme-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  :global(:root[data-theme-preference="light"]) .light,
  :global(:root[data-theme-preference="dark"]) .dark,
  :global(:root[data-theme-preference="system"]) .system,
  :global(:root:not([data-theme-preference])) .system {
    display: block;
  }
</style>
