---
interface Props {
  orientation?: "horizontal" | "vertical";
}

const { orientation = "horizontal" } = Astro.props;
---

<div role="separator" aria-orientation={orientation} class:list={["separator", orientation]}></div>

<style>
  .separator {
    flex-shrink: 0;
  }

  .horizontal {
    width: 100%;
    margin-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .vertical {
    align-self: stretch;
    width: 0;
    min-height: 1.5rem;
    margin-inline: 0.5rem;
    border-left: 1px solid var(--color-border);
  }
</style>
