---
const year = new Date().getFullYear();
---

<footer>
  <p>&copy; {year === 2026 ? "2026" : `2026–${year}`} Chessvault</p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
  }

  p {
    width: min(100% - 3rem, 70rem);
    margin-inline: auto;
    padding-block: 1rem;
    font-size: 0.875rem;
  }
</style>
