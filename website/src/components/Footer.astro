---
const year = new Date().getFullYear();
---

<footer>
  <p>&copy; {year === 2026 ? "2026" : `2026–${year}`} Chessvault</p>
</footer>

<style>
  footer {
    flex-shrink: 0;
    width: 100%;
    max-width: 70rem;
    margin-inline: auto;
    padding-block: 1.5rem;
  }

  p {
    margin: 0;
  }
</style>
