---
import type { MarkdownInstance, MarkdownLayoutProps } from "astro";
import Layout from "./Layout.astro";

type Props = MarkdownLayoutProps<{ title: string }>;
const { frontmatter, headings } = Astro.props;
const sections = headings.filter(({ depth }) => depth === 2 || depth === 3);
const pages = Object.entries(
  import.meta.glob<MarkdownInstance<{ title: string }>>("../pages/docs/**/*.md", { eager: true }),
)
  .map(([path, page]) => {
    const route = path.replace("../pages/", "").replace(/(?:\/index)?\.md$/, "");
    return { title: page.frontmatter.title, href: `${import.meta.env.BASE_URL}${route}/` };
  })
  .sort((a, b) => a.href.localeCompare(b.href));
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<Layout title={`${frontmatter.title} — Chessvault`}>
  <div class="documentation-layout">
    <article class="documentation">
      <h1>{frontmatter.title}</h1>
      <slot />
    </article>
    <aside class="sidebar" aria-label="Documentation navigation">
      <nav aria-labelledby="docs-navigation-title">
        <h2 id="docs-navigation-title">Documentation</h2>
        <ul>
          {pages.map((page) => (
            <li>
              <a href={page.href} aria-current={currentPath === page.href.replace(/\/$/, "") ? "page" : undefined}>
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      {sections.length > 0 && (
        <nav aria-labelledby="page-navigation-title">
          <h2 id="page-navigation-title">On this page</h2>
          <ul>
            {sections.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </aside>
  </div>
</Layout>

<style>
  .documentation-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    align-items: start;
    gap: 3rem;
  }

  .sidebar {
    position: sticky;
    top: 1rem;
    max-height: calc(100svh - 2rem);
    overflow-y: auto;
    overflow-wrap: anywhere;
    margin-block: 1rem 2rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 1px solid var(--color-border);
  }

  .sidebar nav + nav {
    margin-top: 2rem;
  }

  .sidebar h2 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }

  .sidebar ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sidebar a {
    display: block;
    padding-block: 0.375rem;
    text-underline-offset: 0.2em;
  }

  .sidebar a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 800;
  }

  .nested {
    padding-inline-start: 1rem;
  }

  @media (max-width: 50rem) {
    .documentation-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .sidebar {
      grid-row: 1;
      position: static;
      max-height: none;
    }
  }

  .documentation {
    max-width: 72ch;
    overflow-wrap: anywhere;
    padding-block: 1rem 2rem;
  }

  .documentation :global(h2),
  .documentation :global(h3) {
    margin-block: 2rem 0.75rem;
    line-height: 1.3;
  }

  .documentation :global(img) {
    max-width: 100%;
    height: auto;
  }

  .documentation :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
  }

  .documentation :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-accent);
  }
</style>
